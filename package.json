{
  "name": "notion-like-button",
  "version": "1.2.2",
  "description": "chrome-extension-typescript-starter",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:clean": "rimraf dist",
    "build:vite": "vite build",
    "build:zip": "zip -r dist.zip dist",
    "build": "run-s 'build:*'",
    "lint": "run-s 'lint:*'",
    "lint:tsc": "tsc",
    "lint:biome": "biome check .",
    "fix": "run-s 'fix:*'",
    "fix:biome": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "author": "Yusuke Fujiki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fujikky/notion-like-button.git"
  },
  "dependencies": {
    "@linaria/core": "8.2.0",
    "@linaria/react": "8.2.0",
    "@notionhq/client": "2.2.7",
    "@xobotyi/scrollbar-width": "1.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@crxjs/vite-plugin": "2.7.1",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-links": "10.5.8",
    "@storybook/react-vite": "10.5.8",
    "@timetree/biome-config": "jsr:^1.0.3",
    "@types/chrome": "0.2.2",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "@wyw-in-js/vite": "2.4.0",
    "npm-run-all2": "9.0.2",
    "rimraf": "6.1.3",
    "storybook": "10.5.8",
    "typescript": "7.0.2",
    "vite": "5.4.21",
    "vite-tsconfig-paths": "6.1.1"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not ie > 0",
    "not op_mini all"
  ],
  "packageManager": "pnpm@11.23.0"
}
